# Copy to .env and adjust for your environment. Used by infra/docker-compose.yml.
# Never commit a real .env file.

# --- Database ---
DB_USERNAME=supplybase
DB_PASSWORD=supplybase
DB_ROOT_PASSWORD=supplybase_root

# --- Backend ---
SPRING_PROFILES_ACTIVE=docker
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8081
WEBHOOKS_SHARED_SECRET=dev-local-webhook-secret-change-me

# First ADMIN account, created automatically on first startup if none exists yet.
# Change the password immediately after first login; this default is for local/demo use only.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# --- Frontend ---
FRONTEND_PORT=8081

# --- Provider modes (local/demo defaults; a real deployment overrides these) ---
SMS_PROVIDER_MODE=dev_local
IDENTITY_PROVIDER_MODE=manual_review
KIT_PAYMENTS_MODE=dev_simulator
PAYOUTS_MODE=dev_simulator
